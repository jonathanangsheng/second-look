# Copy to .env (gitignored) and fill in. Never commit .env.

# replay (default, no credentials needed) or live (local SSE stream)
MODE=replay

# Ordered provider list, first configured one wins; unconfigured ones are skipped.
# Options: foundry, foundry_serverless, github
LLM_PROVIDER=foundry,github

# Microsoft Foundry: OpenAI-compatible v1 endpoint of your resource and the deployment name.
# Sign-in uses Entra ID (az login / managed identity) unless FOUNDRY_API_KEY is set.
FOUNDRY_OPENAI_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=
FOUNDRY_API_KEY=

# Optional Foundry serverless model (only once its quota exists).
FOUNDRY_SERVERLESS_ENDPOINT=
FOUNDRY_SERVERLESS_MODEL=
FOUNDRY_SERVERLESS_API_KEY=

# GitHub Models: a personal access token with the "models: read" permission
# (or the output of `gh auth token` for your personal account).
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
